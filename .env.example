# Tracker server URL (client uses this to register and generate share links)
TRACKER_URL=https://p2pfiles.provolance.com/fileshare

# Port for the client's internal file server (leave blank to auto-select)
ACCESS_PORT=

# Proxy configuration — all outbound connections are fail-closed without a proxy
# PROXY_HOST and PROXY_PORT must both be set, or neither (falls back to free proxy list)
PROXY_HOST=
PROXY_PORT=
PROXY_TYPE=http
# PROXY_TYPE options: http | socks4 | socks5

# Proxy authentication (both required if proxy needs credentials, or leave both blank)
PROXY_USERNAME=
PROXY_PASSWORD=
